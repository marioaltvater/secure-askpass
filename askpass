SSH_ENCRYPTED_FILE = os.path.expanduser("~/.sudo_askpass.ssh")
AGE_ENCRYPTED_FILE = os.path.expanduser("~/.sudo_askpass.age")
CONFIG_FILE = os.path.expanduser("~/.config/secure-askpass/config.json")
RATE_LIMIT_FILE = os.path.expanduser("~/.config/secure-askpass/rate_limit.json")
AUDIT_LOG_FILE = os.path.expanduser("~/.config/secure-askpass/audit.log")
TOTP_SECRET_FILE = os.path.expanduser("~/.config/secure-askpass/totp_secret.enc")

# age supports SSH Ed25519 and RSA recipients. Other SSH key types are signing
# keys, so they are intentionally not advertised as storage backends here.
SSH_KEY_TYPES = [
    ("~/.ssh/id_ed25519", "Ed25519"),
    ("~/.ssh/id_rsa", "RSA")
]

def check_age_available():
    """Check if age encryption tool is available"""
    try:
        result = subprocess.run(['age', '--version'], capture_output=True)
        return result.returncode == 0
    except FileNotFoundError:
        return False

HAS_AGE = check_age_available()

def find_ssh_keys():
    """Find supported SSH private keys for age decryption."""
    keys = []
    for key_path, key_type in SSH_KEY_TYPES:
        full_path = os.path.expanduser(key_path)
        if os.path.exists(full_path):
            keys.append((full_path, key_type))
    return keys

SSH_KEYS = find_ssh_keys()
SSH_KEY, SSH_KEY_TYPE = SSH_KEYS[0] if SSH_KEYS else (None, None)

def load_totp_secret():
    """Load and decrypt TOTP secret"""
    if not os.path.exists(TOTP_SECRET_FILE):
        return None

    if not HAS_AGE or not SSH_KEYS:
        return None

    try:
        with open(TOTP_SECRET_FILE, 'rb') as f:
            encrypted = f.read()

        command = ['age', '-d']
        for key_path, _ in SSH_KEYS:
            command.extend(['-i', key_path])
        result = subprocess.run(command, input=encrypted, capture_output=True)

        if result.returncode == 0:
            return result.stdout.decode('utf-8').strip()
    except Exception:
        pass

    return None

def verify_totp(secret, provided_code, window=1):
    """Verify TOTP code with time window tolerance"""
    for offset in range(-window, window + 1):
        time_step = 30
        counter = int(time.time() // time_step) + offset
        counter_bytes = struct.pack('>Q', counter)
        key = base64.b32decode(secret.upper().replace(' ', ''))
        hmac_hash = hmac.new(key, counter_bytes, hashlib.sha1).digest()
        offset_byte = hmac_hash[-1] & 0x0f
        code = struct.unpack('>I', hmac_hash[offset_byte:offset_byte+4])[0] & 0x7fffffff
        expected = str(code % 1000000).zfill(6)
        if provided_code == expected:
            return True
    return False

def prompt_totp_confirmation():
    """Prompt for TOTP code via terminal for headless confirmation"""
    secret = load_totp_secret()
    if not secret:
        return False

    command = get_sudo_command()
    hostname = socket.gethostname()
    user = os.environ.get('USER', 'unknown')

    totp_code = None

    # Method 1: Check TOTP environment variable (for automated/piped usage)
    totp_code = os.environ.get('TOTP', '').strip()
    if totp_code:
        syslog.syslog(syslog.LOG_INFO, "TOTP code provided via TOTP environment variable")

    # Method 2: Try to read from /dev/tty (interactive terminal)
    if not totp_code:
        try:
            # Print to stderr so it doesn't interfere with password output
            sys.stderr.write("\n" + "="*50 + "\n")
            sys.stderr.write("SUDO AUTHENTICATION REQUIRED\n")
            sys.stderr.write("="*50 + "\n")
            sys.stderr.write(f"User: {user}\n")
            sys.stderr.write(f"Host: {hostname}\n")
            sys.stderr.write(f"Command: {command}\n")
            sys.stderr.write("-"*50 + "\n")
            sys.stderr.write("Enter TOTP code to authorize: ")
            sys.stderr.flush()

            with open('/dev/tty', 'r') as tty:
                totp_code = tty.readline().strip()
        except Exception:
            pass

    if not totp_code:
        sys.stderr.write("No TOTP code provided. Set TOTP env var or use a terminal.\n")
        return False

    if verify_totp(secret, totp_code):
        sys.stderr.write("TOTP verified - access granted\n")
        sys.stderr.write("="*50 + "\n\n")
        sys.stderr.flush()
        syslog.syslog(syslog.LOG_INFO, "User approved sudo access via TOTP")
        return True
    else:
        sys.stderr.write("Invalid TOTP code - access denied\n")
        sys.stderr.write("="*50 + "\n\n")
        sys.stderr.flush()
        syslog.syslog(syslog.LOG_WARNING, "Invalid TOTP code provided")
        return False

def is_gnome_session():
    """Return True when the current desktop session is GNOME."""
    desktop = " ".join(
        os.environ.get(name, "")
        for name in ("XDG_CURRENT_DESKTOP", "DESKTOP_SESSION")
    ).lower()
    return "gnome" in desktop

def create_hidden_parent_window(title):
    """Create an invisible transient parent window to help center dialogs."""
    window = Gtk.Window(title=title)
    width, height = 640, 400
    display = Gdk.Display.get_default() if HAS_GNOME_UI else None
    if display:
        monitors = display.get_monitors()
        if monitors and monitors.get_n_items() > 0:
            monitor = monitors.get_item(0)
            if monitor:
                geometry = monitor.get_geometry()
                width = max(geometry.width, 640)
                height = max(geometry.height, 400)

    window.set_default_size(width, height)
    window.set_decorated(False)
    window.set_resizable(False)
    window.set_opacity(0.01)
    window.present()
    return window

def build_confirmation_body(user, hostname, command):
    """Build a GNOME-friendly confirmation body."""
    safe_user = GLib.markup_escape_text(user)
    safe_host = GLib.markup_escape_text(hostname)
    safe_command = GLib.markup_escape_text(shorten(command, width=180, placeholder="..."))

    return (
        "<b>Administrator access is required.</b>\n"
        f"User: <tt>{safe_user}</tt>\n"
        f"Host: <tt>{safe_host}</tt>\n"
        f"Command: <tt>{safe_command}</tt>"
    )

def prompt_gnome_confirmation():
    """Show a native GNOME confirmation dialog."""
    if not HAS_GNOME_UI:
        syslog.syslog(syslog.LOG_ERR, "GNOME UI bindings are unavailable")
        return False

    if not (os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY")):
        syslog.syslog(syslog.LOG_WARNING, "No graphical display available for GNOME askpass")
        return False

    if not is_gnome_session():
        syslog.syslog(syslog.LOG_WARNING, "GNOME-only askpass invoked outside a GNOME session")
        return False

    command = get_sudo_command()
    hostname = socket.gethostname()
    user = os.environ.get('USER', 'unknown')

    Adw.init()
    parent = create_hidden_parent_window("Secure Askpass")

    approved = {"value": False}
    loop = GLib.MainLoop()

    def on_response(dialog, result, loop_ref):
        try:
            response = dialog.choose_finish(result)
            approved["value"] = response == "allow"
        except Exception as e:
            syslog.syslog(syslog.LOG_ERR, f"GNOME askpass dialog failed: {e}")
            approved["value"] = False
        finally:
            loop_ref.quit()

    dialog = Adw.AlertDialog()
    dialog.set_heading("Administrator privileges requested")
    dialog.set_body_use_markup(True)
    dialog.set_body(build_confirmation_body(user, hostname, command))
    dialog.add_response("deny", "Deny")
    dialog.add_response("allow", "Allow")
    dialog.set_response_appearance("deny", Adw.ResponseAppearance.DESTRUCTIVE)
    dialog.set_response_appearance("allow", Adw.ResponseAppearance.SUGGESTED)
    dialog.set_close_response("deny")
    dialog.set_default_response("deny")

    details = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
    details.set_margin_top(8)
    details.set_margin_bottom(2)
    details.set_margin_start(2)
    details.set_margin_end(2)

    subtitle = Gtk.Label()
    subtitle.set_wrap(True)
    subtitle.set_xalign(0)
    subtitle.set_use_markup(True)
    subtitle.set_markup("Approve only if you recognize this command.")
    details.append(subtitle)

    command_label = Gtk.Label()
    command_label.set_wrap(True)
    command_label.set_selectable(True)
    command_label.set_xalign(0)
    command_label.add_css_class("monospace")
    command_label.set_markup(
        f"<tt>{GLib.markup_escape_text(shorten(command, width=240, placeholder='...'))}</tt>"
    )
    details.append(command_label)

    dialog.set_extra_child(details)
    dialog.choose(parent, None, on_response, loop)

    try:
        loop.run()
    except KeyboardInterrupt:
        return False
    finally:
        parent.close()

    return approved["value"]

# Default security configurations
DEFAULT_CONFIG = {
    "require_user_confirmation": True,
    "allowed_paths": ["/"],
    "expiration_hours": 24,
    "sudo_parent_processes": ["sudo", "sudo.ws"],
    "max_attempts_per_hour": 30,
    "lockout_minutes": 15
}

# Load configuration
def load_config():
    config = DEFAULT_CONFIG.copy()

    local_config = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'askpass-config.json')
    if os.path.exists(local_config):
        try:
            import json
            with open(local_config, 'r') as f:
                user_config = json.load(f)
                config.update(user_config)
        except:
            pass

    # Per-user config is loaded last so VM-local choices always win.
    if os.path.exists(CONFIG_FILE):
        try:
            import json
            with open(CONFIG_FILE, 'r') as f:
                user_config = json.load(f)
                config.update(user_config)
        except:
            pass
    
    return config

config = load_config()
ALLOWED_PATHS = config['allowed_paths']
EXPIRATION_HOURS = config['expiration_hours']
SUDO_PARENT_PROCESSES = config.get('sudo_parent_processes', config.get('allowed_processes', ["sudo", "sudo.ws"]))
REQUIRE_USER_CONFIRMATION = config['require_user_confirmation']
MAX_ATTEMPTS_PER_HOUR = config['max_attempts_per_hour']
LOCKOUT_MINUTES = config['lockout_minutes']

def check_rate_limit():
    """Check if rate limit has been exceeded"""
    import json
    from datetime import datetime, timedelta
    
    try:
        # Load rate limit data
        if os.path.exists(RATE_LIMIT_FILE):
            with open(RATE_LIMIT_FILE, 'r') as f:
                rate_data = json.load(f)
        else:
            rate_data = {"attempts": [], "lockout_until": None}
        
        now = datetime.now()
        
        # Check if locked out
        if rate_data.get("lockout_until"):
            lockout_until = datetime.fromisoformat(rate_data["lockout_until"])
            if now < lockout_until:
                remaining = int((lockout_until - now).total_seconds() / 60)
                syslog.syslog(syslog.LOG_WARNING, f"Rate limit lockout in effect for {remaining} more minutes")
                return False
            else:
                # Lockout expired
                rate_data["lockout_until"] = None
        
        # Clean old attempts (older than 1 hour)
        one_hour_ago = now - timedelta(hours=1)
        rate_data["attempts"] = [
            attempt for attempt in rate_data["attempts"]
            if datetime.fromisoformat(attempt) > one_hour_ago
        ]
        
        # Check attempt count
        if len(rate_data["attempts"]) >= MAX_ATTEMPTS_PER_HOUR:
            # Apply lockout
            lockout_until = now + timedelta(minutes=LOCKOUT_MINUTES)
            rate_data["lockout_until"] = lockout_until.isoformat()
            syslog.syslog(syslog.LOG_WARNING, f"Rate limit exceeded, locking out for {LOCKOUT_MINUTES} minutes")
            
            # Save rate limit data
            os.makedirs(os.path.dirname(RATE_LIMIT_FILE), exist_ok=True)
            with open(RATE_LIMIT_FILE, 'w') as f:
                json.dump(rate_data, f)
            
            return False
        
        # Record this attempt
        rate_data["attempts"].append(now.isoformat())
        
        # Save rate limit data
        os.makedirs(os.path.dirname(RATE_LIMIT_FILE), exist_ok=True)
        with open(RATE_LIMIT_FILE, 'w') as f:
            json.dump(rate_data, f)
        
        return True
        
    except Exception as e:
        syslog.syslog(syslog.LOG_ERR, f"Rate limit check failed: {e}")
        # Fail open to avoid lockout due to errors
        return True

def get_sudo_command():
    """Try to determine what command sudo is trying to run"""
    try:
        # Get parent process command line
        ppid = os.getppid()
        with open(f'/proc/{ppid}/cmdline', 'r') as f:
            cmdline = f.read().replace('\0', ' ').strip()
            # Extract the actual command after sudo flags
            parts = cmdline.split()
            if 'sudo' in parts[0]:
                # Find the actual command (skip sudo and its flags)
                for i, part in enumerate(parts):
                    if not part.startswith('-') and part != 'sudo':
                        return ' '.join(parts[i:])
        return "Unknown command"
    except:
        return "Unknown command"

def check_security():
    """Perform security checks before retrieving password"""
    # 0. Rate limit check
    if not check_rate_limit():
        return False
    
    # 1. Path-based restriction
    cwd = os.getcwd()
    if not any(cwd.startswith(path) for path in ALLOWED_PATHS):
        syslog.syslog(syslog.LOG_WARNING, f"Askpass called from unauthorized path: {cwd}")
        return False
    
    # 2. Validate that sudo itself invoked askpass. The originating agent or
    # shell is not a reliable parent here; sudo is.
    try:
        ppid = os.getppid()
        proc_name = open(f'/proc/{ppid}/comm').read().strip()
        if proc_name not in SUDO_PARENT_PROCESSES:
            syslog.syslog(syslog.LOG_WARNING, f"Askpass called by unexpected parent process: {proc_name}")
            return False
    except Exception:
        syslog.syslog(syslog.LOG_WARNING, "Could not determine parent process")
        return False
    
    # 3. Environment verification
    if not (os.getenv('SSH_AUTH_SOCK') or os.getenv('SSH_TTY') or os.getenv('TERM')):
        syslog.syslog(syslog.LOG_WARNING, "Askpass called without proper environment")
        return False

    # 3b. GNOME session requirement
    if not is_gnome_session():
        syslog.syslog(syslog.LOG_WARNING, "Askpass called outside a GNOME session")
        return False
    
    # 4. Time-based expiration check
    for encrypted_file in (AGE_ENCRYPTED_FILE, SSH_ENCRYPTED_FILE):
        if not os.path.exists(encrypted_file):
            continue
        file_age = time.time() - os.path.getmtime(encrypted_file)
        if file_age > EXPIRATION_HOURS * 3600:
            syslog.syslog(syslog.LOG_INFO, f"Password file expired after {EXPIRATION_HOURS} hours: {encrypted_file}")
            try:
                os.remove(encrypted_file)
            except:
                pass
            return False
    
    # 5. User confirmation dialog (GNOME only)
    if REQUIRE_USER_CONFIRMATION:
        if not prompt_gnome_confirmation():
            syslog.syslog(syslog.LOG_WARNING, "User denied sudo access via dialog")
            return False
        syslog.syslog(syslog.LOG_INFO, "User approved sudo access via dialog")
    
    return True

def ensure_ssh_key_loaded(key_path):
    """Ensure SSH key is loaded in ssh-agent, prompt for passphrase if needed"""
    if not key_path or not os.path.exists(key_path):
        return False

    try:
        # Check if ssh-agent is running
        if not os.environ.get('SSH_AUTH_SOCK'):
            # Start ssh-agent
            result = subprocess.run(['ssh-agent', '-s'], capture_output=True, text=True)
            if result.returncode == 0:
                # Parse and set environment variables
                for line in result.stdout.split('\n'):
                    if '=' in line and 'echo' not in line:
                        key, value = line.split(';')[0].split('=', 1)
                        os.environ[key.strip()] = value.strip().strip('"').strip("'")

        # Check if key is already loaded
        check_result = subprocess.run(['ssh-add', '-l'], capture_output=True)
        if check_result.returncode == 0:
            # Check if our specific key is loaded
            key_fingerprint = subprocess.run(
                ['ssh-keygen', '-lf', key_path],
                capture_output=True,
                text=True
            )
            if key_fingerprint.returncode == 0:
                fingerprint = key_fingerprint.stdout.split()[1]
                if fingerprint in check_result.stdout.decode():
                    return True

        # Key not loaded, prompt for passphrase
        passphrase = prompt_ssh_passphrase(key_path)
        if not passphrase:
            return False

        # Add key to ssh-agent with passphrase
        add_result = subprocess.run(
            ['ssh-add', key_path],
            input=passphrase.encode(),
            capture_output=True
        )

        # Clear passphrase from memory
        passphrase = None

        return add_result.returncode == 0

    except Exception as e:
        syslog.syslog(syslog.LOG_ERR, f"Failed to ensure SSH key loaded: {e}")
        return False

def prompt_ssh_passphrase(key_path):
    """Prompt for SSH key passphrase using a GNOME dialog."""
    if not HAS_GNOME_UI:
        syslog.syslog(syslog.LOG_ERR, "GNOME UI bindings are unavailable")
        return None

    if not (os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY")):
        syslog.syslog(syslog.LOG_WARNING, "No graphical display available for SSH key prompt")
        return None

    if not is_gnome_session():
        syslog.syslog(syslog.LOG_WARNING, "SSH key prompt requested outside a GNOME session")
        return None

    Adw.init()
    parent = create_hidden_parent_window("Secure Askpass")

    result = {"value": None}
    loop = GLib.MainLoop()

    def on_response(dialog, async_result, loop_ref):
        try:
            response = dialog.choose_finish(async_result)
            if response == "unlock":
                result["value"] = entry.get_text()
        except Exception as e:
            syslog.syslog(syslog.LOG_ERR, f"GNOME SSH prompt failed: {e}")
        finally:
            loop_ref.quit()

    dialog = Adw.AlertDialog()
    dialog.set_heading("SSH key passphrase required")
    dialog.set_body(
        f"Unlock {key_path} so sudo can reuse your SSH key for encrypted storage."
    )
    dialog.add_response("cancel", "Cancel")
    dialog.add_response("unlock", "Unlock")
    dialog.set_response_appearance("cancel", Adw.ResponseAppearance.DEFAULT)
    dialog.set_response_appearance("unlock", Adw.ResponseAppearance.SUGGESTED)
    dialog.set_close_response("cancel")
    dialog.set_default_response("cancel")

    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
    box.set_margin_top(8)
    box.set_margin_bottom(2)
    box.set_margin_start(2)
    box.set_margin_end(2)

    entry = Gtk.PasswordEntry()
    entry.set_show_peek_icon(True)
    entry.set_placeholder_text("SSH key passphrase")
    box.append(entry)

    dialog.set_extra_child(box)
    dialog.choose(parent, None, on_response, loop)

    try:
        loop.run()
    except KeyboardInterrupt:
        return None
    finally:
        parent.close()

    return result["value"]

def decrypt_with_age(encrypted_file):
    """Decrypt data using age with SSH private key"""
    if not HAS_AGE or not SSH_KEYS:
        return None

    try:
        with open(encrypted_file, 'rb') as f:
            encrypted_data = f.read()

        for key_path, key_type in SSH_KEYS:
            result = subprocess.run(
                ['age', '-d', '-i', key_path],
                input=encrypted_data,
                capture_output=True
            )

            if result.returncode == 0:
                return result.stdout.decode('utf-8').strip()

            if not ensure_ssh_key_loaded(key_path):
                syslog.syslog(syslog.LOG_WARNING, f"Failed to load {key_type} SSH key into ssh-agent")
                continue

            result = subprocess.run(
                ['age', '-d', '-i', key_path],
                input=encrypted_data,
                capture_output=True
            )

            if result.returncode == 0:
                return result.stdout.decode('utf-8').strip()

    except Exception:
        pass

    return None

def validate_environment():
    """Validate SUDO_ASKPASS environment variable to prevent hijacking"""
    askpass_path = os.environ.get('SUDO_ASKPASS', '')
    if not askpass_path:
        return True  # Not using askpass
    
    # Get the real path of this script
    this_script = os.path.realpath(os.path.abspath(__file__))
    provided_script = os.path.realpath(os.path.abspath(askpass_path))
    
    if this_script != provided_script:
        syslog.syslog(syslog.LOG_CRIT, f"SUDO_ASKPASS hijacking detected! Expected: {this_script}, Got: {provided_script}")
        return False
    
    # Check file permissions (should not be writable by others)
    stats = os.stat(this_script)
    if stats.st_mode & 0o022:  # Check for group/other write permissions
        syslog.syslog(syslog.LOG_CRIT, f"SUDO_ASKPASS script has insecure permissions: {oct(stats.st_mode)}")
        return False
    
    return True

def secure_memory_clear(data):
    """Attempt to clear sensitive data from memory"""
    if isinstance(data, str):
        # Convert to mutable bytearray to overwrite
        as_bytes = bytearray(data, 'utf-8')
        for i in range(len(as_bytes)):
            as_bytes[i] = 0
    return None

def main():
    # Initialize syslog
    syslog.openlog("sudo-askpass")
    
    # Validate environment to prevent hijacking
    if not validate_environment():
        print("Error: Environment validation failed", file=sys.stderr)
        sys.exit(1)
    
    # Perform security checks (including user confirmation)
    if not check_security():
        print("Error: Security check failed", file=sys.stderr)
        syslog.syslog(syslog.LOG_ERR, "Security check failed")
        sys.exit(1)
    
    # Log successful security check
    try:
        ppid = os.getppid()
        proc_name = open(f'/proc/{ppid}/comm').read().strip()
        command = get_sudo_command()
        syslog.syslog(syslog.LOG_INFO, f"Askpass approved for {proc_name} (pid {ppid}): {command}")
        
        # Write to audit log
        from datetime import datetime
        audit_entry = {
            "timestamp": datetime.now().isoformat(),
            "pid": ppid,
            "process": proc_name,
            "command": command,
            "user": os.environ.get('USER', 'unknown'),
            "cwd": os.getcwd(),
            "status": "approved"
        }
        
        os.makedirs(os.path.dirname(AUDIT_LOG_FILE), exist_ok=True)
        with open(AUDIT_LOG_FILE, 'a') as f:
            import json
            f.write(json.dumps(audit_entry) + '\n')
    except:
        syslog.syslog(syslog.LOG_INFO, "Askpass called (process info unavailable)")
    
    password = None

    if os.path.exists(AGE_ENCRYPTED_FILE):
        password = decrypt_with_age(AGE_ENCRYPTED_FILE)
        if password:
            print(password)
            key_info = f" ({SSH_KEY_TYPE} key)" if SSH_KEY_TYPE else ""
            syslog.syslog(syslog.LOG_INFO, f"Password retrieved via age encryption{key_info}")
            password = secure_memory_clear(password)
            return

    if os.path.exists(SSH_ENCRYPTED_FILE):
        syslog.syslog(syslog.LOG_WARNING, f"Legacy OpenSSL password file ignored: {SSH_ENCRYPTED_FILE}")
    
    # No password found
    print("Error: No password found in secure storage", file=sys.stderr)
    print("Use 'askpass-manager set' to store the password securely", file=sys.stderr)
    syslog.syslog(syslog.LOG_ERR, "No password found in secure storage")
    sys.exit(1)

if __name__ == "__main__":
    main()
