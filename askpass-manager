#!/usr/bin/env python3
"""
Askpass manager that uses SSH key encryption by default
"""

import sys
import subprocess
import os
import getpass
import socket
import hashlib
import hmac
import struct
import time
import base64

try:
    import gi
    gi.require_version('Gtk', '4.0')
    gi.require_version('Adw', '1')
    gi.require_version('Gdk', '4.0')
    from gi.repository import Adw, GLib, Gtk, Gdk
    HAS_GNOME_UI = True
except Exception:
    HAS_GNOME_UI = False

TOTP_SECRET_FILE = os.path.expanduser("~/.config/secure-askpass/totp_secret.enc")

SSH_ENCRYPTED_FILE = os.path.expanduser("~/.sudo_askpass.ssh")
AGE_ENCRYPTED_FILE = os.path.expanduser("~/.sudo_askpass.age")

# age supports SSH Ed25519 and RSA recipients. ECDSA/DSA are signing keys and
# are intentionally not used for password encryption.
SSH_KEY_TYPES = [
    ("~/.ssh/id_ed25519", "~/.ssh/id_ed25519.pub", "Ed25519"),
    ("~/.ssh/id_rsa", "~/.ssh/id_rsa.pub", "RSA")
]

def check_age_available():
    """Check if age encryption tool is available"""
    try:
        result = subprocess.run(['age', '--version'], capture_output=True)
        return result.returncode == 0
    except FileNotFoundError:
        return False

HAS_AGE = check_age_available()

def find_ssh_keypair():
    """Find the first supported SSH keypair."""
    for priv_path, pub_path, key_type in SSH_KEY_TYPES:
        priv_full = os.path.expanduser(priv_path)
        pub_full = os.path.expanduser(pub_path)
        if os.path.exists(priv_full) and os.path.exists(pub_full):
            return priv_full, pub_full, key_type
    return None, None, None

SSH_KEY, SSH_PUB, SSH_KEY_TYPE = find_ssh_keypair()

def create_hidden_parent_window(title):
    """Create an invisible transient parent window to help center dialogs."""
    window = Gtk.Window(title=title)
    width, height = 640, 400
    display = Gdk.Display.get_default() if HAS_GNOME_UI else None
    if display:
        monitors = display.get_monitors()
        if monitors and monitors.get_n_items() > 0:
            monitor = monitors.get_item(0)
            if monitor:
                geometry = monitor.get_geometry()
                width = max(geometry.width, 640)
                height = max(geometry.height, 400)

    window.set_default_size(width, height)
    window.set_decorated(False)
    window.set_resizable(False)
    window.set_opacity(0.01)
    window.present()
    return window

def find_unsupported_ssh_keys():
    unsupported = []
    for key_name in ("id_ecdsa", "id_dsa"):
        priv = os.path.expanduser(f"~/.ssh/{key_name}")
        pub = os.path.expanduser(f"~/.ssh/{key_name}.pub")
        if os.path.exists(priv) or os.path.exists(pub):
            unsupported.append(key_name)
    return unsupported

def generate_totp_secret():
    """Generate a random 20-byte TOTP secret"""
    return base64.b32encode(os.urandom(20)).decode('ascii')

def verify_totp(secret, provided_code, window=1):
    """Verify TOTP code with optional time window tolerance"""
    for offset in range(-window, window + 1):
        time_step = 30
        counter = int(time.time() // time_step) + offset
        counter_bytes = struct.pack('>Q', counter)
        key = base64.b32decode(secret.upper().replace(' ', ''))
        hmac_hash = hmac.new(key, counter_bytes, hashlib.sha1).digest()
        offset_byte = hmac_hash[-1] & 0x0f
        code = struct.unpack('>I', hmac_hash[offset_byte:offset_byte+4])[0] & 0x7fffffff
        expected = str(code % 1000000).zfill(6)
        if provided_code == expected:
            return True
    return False

def save_totp_secret(secret):
    """Save TOTP secret encrypted with SSH key"""
    if not HAS_AGE or not SSH_PUB:
        print("Error: TOTP setup requires age and SSH keys", file=sys.stderr)
        return False

    encrypted = encrypt_with_age(secret)
    if encrypted:
        os.makedirs(os.path.dirname(TOTP_SECRET_FILE), exist_ok=True)
        with open(TOTP_SECRET_FILE, 'wb') as f:
            f.write(encrypted)
        os.chmod(TOTP_SECRET_FILE, 0o600)
        return True
    return False

def load_totp_secret():
    """Load and decrypt TOTP secret"""
    if not os.path.exists(TOTP_SECRET_FILE):
        return None

    if not HAS_AGE or not SSH_KEY:
        return None

    try:
        with open(TOTP_SECRET_FILE, 'rb') as f:
            encrypted = f.read()

        result = subprocess.run(
            ['age', '-d', '-i', SSH_KEY],
            input=encrypted,
            capture_output=True
        )

        if result.returncode == 0:
            return result.stdout.decode('utf-8').strip()
    except Exception:
        pass

    return None

def setup_totp():
    """Set up TOTP for headless password entry"""
    if not HAS_AGE:
        print("Error: TOTP requires 'age' encryption tool", file=sys.stderr)
        print("Install: sudo apt install age", file=sys.stderr)
        return False

    if not SSH_PUB:
        print("Error: TOTP requires SSH keys", file=sys.stderr)
        return False

    secret = generate_totp_secret()

    if not save_totp_secret(secret):
        print("Error: Failed to save TOTP secret", file=sys.stderr)
        return False

    hostname = socket.gethostname()
    username = os.environ.get('USER', 'user')

    print("\n" + "="*60)
    print("TOTP Setup Complete!")
    print("="*60)
    print(f"\nSecret: {secret}")
    print(f"\nAdd this to your authenticator app:")
    print(f"  Account: {username}@{hostname} (sudo-askpass)")
    print(f"  Secret:  {secret}")
    print(f"\nOr scan this URL in your authenticator:")
    print(f"  otpauth://totp/{username}@{hostname}:sudo-askpass?secret={secret}&issuer=secure-askpass")
    print("\n" + "="*60)
    print("\nYou can now use: askpass-manager set-totp")
    print("to set your password from a headless session.")
    print("="*60 + "\n")

    return True

def set_password_with_totp():
    """Set password using TOTP verification (for headless sessions)"""
    secret = load_totp_secret()

    if not secret:
        print("Error: TOTP not configured. Run 'askpass-manager totp-setup' first.", file=sys.stderr)
        return False

    print("TOTP-authenticated password entry (headless mode)")
    print("-" * 50)

    # Check if running interactively
    is_tty = sys.stdin.isatty()

    if is_tty:
        totp_code = input("Enter TOTP code from authenticator: ").strip()
    else:
        # Read from stdin (piped input)
        totp_code = sys.stdin.readline().strip()

    if not verify_totp(secret, totp_code):
        print("Error: Invalid TOTP code", file=sys.stderr)
        return False

    print("TOTP verified!")

    if is_tty:
        password = getpass.getpass("Enter sudo password to store: ")
        confirm = getpass.getpass("Confirm password: ")
    else:
        # Read password and confirmation from stdin (piped)
        password = sys.stdin.readline().strip()
        confirm = sys.stdin.readline().strip()

    if password != confirm:
        print("Error: Passwords don't match", file=sys.stderr)
        return False

    return store_password_internal(password)

def store_password_internal(password):
    """Internal function to store password (shared by set and set-totp)"""
    def secure_clear(data):
        if data:
            temp = bytearray(data, 'utf-8')
            for i in range(len(temp)):
                temp[i] = 0

    if not HAS_AGE:
        print("Error: secure-askpass requires the 'age' encryption tool", file=sys.stderr)
        print("Install age, then run askpass-manager set again.", file=sys.stderr)
        return False

    if not SSH_KEY or not SSH_PUB:
        unsupported = find_unsupported_ssh_keys()
        if unsupported:
            print(f"Error: found unsupported SSH key(s): {', '.join(unsupported)}", file=sys.stderr)
            print("Use an Ed25519 or RSA SSH key for secure-askpass storage.", file=sys.stderr)
        else:
            print("Error: no supported SSH keypair found", file=sys.stderr)
            print("Generate one with: ssh-keygen -t ed25519", file=sys.stderr)
        return False

    encrypted = encrypt_with_age(password)
    if encrypted:
        try:
            with open(AGE_ENCRYPTED_FILE, 'wb') as f:
                f.write(encrypted)
            os.chmod(AGE_ENCRYPTED_FILE, 0o600)
            print(f"Password encrypted with age using your {SSH_KEY_TYPE} SSH key and stored in {AGE_ENCRYPTED_FILE}")
            secure_clear(password)
            return True
        except Exception as e:
            print(f"Error saving age encrypted file: {e}", file=sys.stderr)

    print("Error: Unable to store password securely", file=sys.stderr)
    return False

def encrypt_with_age(password):
    """Encrypt password with age using SSH public key"""
    if not HAS_AGE or not SSH_PUB:
        return None

    try:
        result = subprocess.run(
            ['age', '-R', SSH_PUB, '-a'],
            input=password.encode(),
            capture_output=True
        )

        if result.returncode == 0:
            return result.stdout
        if result.stderr:
            print(result.stderr.decode('utf-8', errors='replace').strip(), file=sys.stderr)

    except Exception:
        pass

    return None

def get_password_via_gnome():
    """Get password using a native GNOME dialog."""
    if not HAS_GNOME_UI:
        print("Error: GNOME UI bindings are unavailable", file=sys.stderr)
        return None, None

    if not (os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY")):
        print("Error: GNOME askpass manager requires a graphical session", file=sys.stderr)
        return None, None

    desktop = " ".join(
        os.environ.get(name, "")
        for name in ("XDG_CURRENT_DESKTOP", "DESKTOP_SESSION")
    ).lower()
    if "gnome" not in desktop:
        print("Error: GNOME askpass manager requires a GNOME session", file=sys.stderr)
        return None, None

    Adw.init()
    parent = create_hidden_parent_window("Askpass Manager")

    result = {"password": None, "confirm": None}
    loop = GLib.MainLoop()

    def finish(dialog, async_result, loop_ref):
        try:
            response = dialog.choose_finish(async_result)
            if response == "store":
                result["password"] = password_entry.get_text()
                result["confirm"] = confirm_entry.get_text()
        except Exception as e:
            print(f"Error: GNOME password dialog failed: {e}", file=sys.stderr)
        finally:
            loop_ref.quit()

    dialog = Adw.AlertDialog()
    dialog.set_heading("Store sudo password")
    dialog.set_body(
        "Enter the sudo password you want to store, then confirm it below."
    )
    dialog.add_response("cancel", "Cancel")
    dialog.add_response("store", "Store")
    dialog.set_response_appearance("cancel", Adw.ResponseAppearance.DEFAULT)
    dialog.set_response_appearance("store", Adw.ResponseAppearance.SUGGESTED)
    dialog.set_close_response("cancel")
    dialog.set_default_response("cancel")

    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
    box.set_margin_top(8)
    box.set_margin_bottom(2)
    box.set_margin_start(2)
    box.set_margin_end(2)

    password_entry = Gtk.PasswordEntry()
    password_entry.set_show_peek_icon(True)
    password_entry.set_placeholder_text("Password")
    box.append(password_entry)

    confirm_entry = Gtk.PasswordEntry()
    confirm_entry.set_show_peek_icon(True)
    confirm_entry.set_placeholder_text("Confirm password")
    box.append(confirm_entry)

    help_label = Gtk.Label()
    help_label.set_wrap(True)
    help_label.set_xalign(0)
    help_label.set_text("This dialog follows GNOME dark mode automatically.")
    box.append(help_label)

    dialog.set_extra_child(box)
    dialog.choose(parent, None, finish, loop)

    try:
        loop.run()
    except KeyboardInterrupt:
        return None, None
    finally:
        parent.close()

    return result["password"], result["confirm"]

def set_password():
    """Store password encrypted with age and a supported SSH key."""
    print("Storing your sudo password...")
    
    # Get password via GNOME dialog
    password, confirm = get_password_via_gnome()
    
    if not password or not confirm:
        print("Error: Password entry cancelled", file=sys.stderr)
        return False
    
    if password != confirm:
        print("Error: Passwords don't match", file=sys.stderr)
        return False
    
    return store_password_internal(password)

def get_password():
    """Check for stored password."""
    if os.path.exists(AGE_ENCRYPTED_FILE):
        print("Password found (age encrypted with SSH key)")
        return True

    if os.path.exists(SSH_ENCRYPTED_FILE):
        print("Legacy OpenSSL password file found, but current secure-askpass uses age")
        print("Run 'askpass-manager set' to rewrite it as ~/.sudo_askpass.age")
        return False

    print("No password found")
    return False

def clear_password():
    """Clear all stored passwords"""
    cleared = False

    # Clear age encrypted file
    if os.path.exists(AGE_ENCRYPTED_FILE):
        try:
            os.remove(AGE_ENCRYPTED_FILE)
            print("Age encrypted password cleared")
            cleared = True
        except Exception as e:
            print(f"Error clearing age encrypted file: {e}")

    # Clear SSH encrypted file
    if os.path.exists(SSH_ENCRYPTED_FILE):
        try:
            os.remove(SSH_ENCRYPTED_FILE)
            print("SSH encrypted password cleared")
            cleared = True
        except Exception as e:
            print(f"Error clearing SSH encrypted file: {e}")
    
    # Clear legacy files if they exist (cleanup)
    legacy_files = [
        SSH_ENCRYPTED_FILE,
        os.path.expanduser("~/.sudo_askpass.enc"),
        os.path.expanduser("~/.sudo_askpass"),
        os.path.expanduser("~/.sudo_askpass.gpg")
    ]
    
    for file_path in legacy_files:
        if os.path.exists(file_path):
            try:
                os.remove(file_path)
                print(f"Cleared legacy file: {file_path}")
                cleared = True
            except Exception as e:
                print(f"Error clearing {file_path}: {e}")
    
    if not cleared:
        print("No password found to clear")
    
    return cleared

def test_sudo():
    """Test sudo with askpass"""
    askpass_path = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'askpass')
    
    if not os.path.exists(askpass_path):
        print(f"Error: askpass script not found at {askpass_path}", file=sys.stderr)
        return False
    
    # Make sure askpass is executable
    os.chmod(askpass_path, 0o755)
    
    env = os.environ.copy()
    env['SUDO_ASKPASS'] = askpass_path
    
    print("Testing sudo with askpass (forcing a fresh sudo authentication)...")
    result = subprocess.run(['sudo', '-k', '-A', 'echo', 'Success!'],
                           env=env, capture_output=True, text=True)
    
    if result.returncode == 0:
        print("Test successful:", result.stdout.strip())
        return True
    else:
        print("Test failed:", result.stderr.strip(), file=sys.stderr)
        return False

def doctor():
    """Check local prerequisites without invoking sudo."""
    ok = True
    print("secure-askpass doctor")
    print("-" * 24)

    if HAS_AGE:
        print("age: found")
    else:
        print("age: missing", file=sys.stderr)
        ok = False

    if SSH_KEY and SSH_PUB:
        print(f"ssh key: {SSH_KEY_TYPE} ({SSH_KEY})")
    else:
        print("ssh key: no supported Ed25519 or RSA keypair found", file=sys.stderr)
        unsupported = find_unsupported_ssh_keys()
        if unsupported:
            print(f"unsupported key(s): {', '.join(unsupported)}", file=sys.stderr)
        ok = False

    askpass_path = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'askpass')
    if os.path.exists(askpass_path) and os.access(askpass_path, os.X_OK):
        print(f"askpass: executable ({askpass_path})")
    else:
        print(f"askpass: not executable ({askpass_path})", file=sys.stderr)
        ok = False

    if os.path.exists(AGE_ENCRYPTED_FILE):
        mode = oct(os.stat(AGE_ENCRYPTED_FILE).st_mode & 0o777)
        print(f"stored password: {AGE_ENCRYPTED_FILE} ({mode})")
        if mode != "0o600":
            ok = False
    else:
        print("stored password: missing")

    return ok

def show_audit_log():
    """Display recent audit log entries"""
    audit_file = os.path.expanduser("~/.config/secure-askpass/audit.log")
    
    if not os.path.exists(audit_file):
        print("No audit log found")
        return True
    
    try:
        import json
        from datetime import datetime
        
        # Read last 50 entries
        with open(audit_file, 'r') as f:
            lines = f.readlines()[-50:]
        
        print(f"\nRecent askpass usage (last {len(lines)} entries):")
        print("-" * 80)
        
        for line in lines:
            try:
                entry = json.loads(line.strip())
                timestamp = datetime.fromisoformat(entry['timestamp'])
                print(f"{timestamp.strftime('%Y-%m-%d %H:%M:%S')} | "
                      f"User: {entry['user']} | "
                      f"Process: {entry['process']} | "
                      f"Command: {entry['command'][:50]}...")
            except:
                pass
        
        print("-" * 80)
        return True
    except Exception as e:
        print(f"Error reading audit log: {e}")
        return False

def main():
    if len(sys.argv) < 2:
        print("Usage: askpass-manager [set|set-totp|totp-setup|get|clear|test|doctor|audit]")
        print()
        print("Commands:")
        print("  set        - Store password (GUI/terminal input)")
        print("  set-totp   - Store password with TOTP verification (headless)")
        print("  totp-setup - Set up TOTP for headless password entry")
        print("  get        - Check if password exists")
        print("  clear      - Remove stored password")
        print("  test       - Test sudo with askpass and force fresh auth")
        print("  doctor     - Check local prerequisites without sudo")
        print("  audit      - Show recent askpass usage")
        print()
        print("Storage:")
        print("  age-encrypted file using an Ed25519 or RSA SSH key")
        print()
        print("For headless/SSH sessions:")
        print("  1. Run 'totp-setup' once from a GUI session")
        print("  2. Add the secret to your authenticator app")
        print("  3. Use 'set-totp' from any session with TOTP code")
        sys.exit(1)

    command = sys.argv[1]

    if command == "set":
        success = set_password()
    elif command == "set-totp":
        success = set_password_with_totp()
    elif command == "totp-setup":
        success = setup_totp()
    elif command == "get":
        success = get_password()
    elif command == "clear":
        success = clear_password()
    elif command == "test":
        success = test_sudo()
    elif command == "doctor":
        success = doctor()
    elif command == "audit":
        success = show_audit_log()
    else:
        print(f"Unknown command: {command}", file=sys.stderr)
        success = False

    sys.exit(0 if success else 1)

if __name__ == "__main__":
    main()
